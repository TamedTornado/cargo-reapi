#!/bin/sh
set -eu
# cargo-reapi-rustc-observer: cargo-reapi recognizes this shim by this line.

: "${CARGO_REAPI_REAL_RUSTC:?CARGO_REAPI_REAL_RUSTC is required}"
: "${CARGO_REAPI_RUSTC_TRACE:?CARGO_REAPI_RUSTC_TRACE is required}"

test -d "$CARGO_REAPI_RUSTC_TRACE"
kind=compile
previous=
crate_name=
for argument in "$@"; do
  if [ "$previous" = "--crate-name" ]; then
    crate_name=$argument
  fi
  case "$argument" in
    --print|--print=*) kind=query ;;
  esac
  previous=$argument
done
if [ -z "$crate_name" ]; then
  kind=query
  crate_name=control
fi

record=$(mktemp "$CARGO_REAPI_RUSTC_TRACE/rustc-observation.XXXXXX")
{
  printf 'kind=%s\n' "$kind"
  printf 'crate_name=%s\n' "$crate_name"
  printf 'cwd=%s\n' "$(pwd -P)"
} >"$record"

# The audit variables are this shim's own: the compiler never sees them, so
# nothing a crate reads (`option_env!`) depends on where a trace is kept.
real_rustc=$CARGO_REAPI_REAL_RUSTC
unset CARGO_REAPI_REAL_RUSTC CARGO_REAPI_RUSTC_TRACE
exec "$real_rustc" "$@"
